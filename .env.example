# Razorpay Test Mode Credentials
# Get these from your Razorpay Dashboard: Settings -> API Keys -> Generate Key (in Test Mode)

# Frontend Razorpay Key ID (Safe to expose to browser)
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere

# Server-side Razorpay Key ID & Secret (NEVER expose Key Secret to frontend)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
